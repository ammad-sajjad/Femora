# Copy this file to backend/.env and put your own key in it. backend/.env is git-ignored on purpose: never commit it.
# Get a key at https://aistudio.google.com/apikey (the free tier allows about 10 AI-voice replies a day per voice model;
# a paid key removes that limit).
GEMINI_API_KEY=

# Optional overrides (defaults are in backend/companion.py)
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# GEMINI_CHAT_MODEL_BACKUP=gemini-3.6-flash
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_MODEL_BACKUP=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
