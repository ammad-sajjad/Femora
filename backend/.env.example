# Copy this file to backend/.env and put your own key in it. backend/.env is git-ignored on purpose: never commit it.
# Get a key at https://aistudio.google.com/apikey (the free tier allows about 10 AI-voice replies a day per voice model;
# a paid key removes that limit).
GEMINI_API_KEY=

# Optional overrides (defaults are in backend/companion.py)
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_CHAT_MODEL_FAST=gemini-3.1-flash-lite
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_MODEL_BACKUP=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# Femora on WhatsApp (optional; see backend/README.md). Leave empty to switch it off.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=   (any long random text you choose; paste the same text into the Meta dashboard)
# WHATSAPP_APP_SECRET=     (Meta app > Settings > Basic > App secret; used to check that deliveries really come from Meta)

# Nearby care map (optional): with a Google Places key the map shows ratings and reviews; without it, OpenStreetMap is used.
# GOOGLE_PLACES_API_KEY=
