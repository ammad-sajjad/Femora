# Copy to .env.local for local runs, and add the same three in Vercel → Project → Settings → Environment Variables.

# Who may sign in to the admin panel
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line (or base64 of it). Same value the Railway backend uses.
FIREBASE_SERVICE_ACCOUNT=

# Optional: signs the admin session cookie (defaults to ADMIN_PASSWORD). Any long random string.
# SESSION_SECRET=
